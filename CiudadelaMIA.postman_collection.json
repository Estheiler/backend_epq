				{
					"name": "Iniciar Sesión (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response.success && response.data && response.data.access_token) {",
									"    pm.collectionVariables.set(\"token\", response.data.access_token);",
									"    console.log(\"Token JWT guardado automáticamente en la colección.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"superadmin\",\n    \"password\": \"superadminCiudadela123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Autentica al usuario y guarda automáticamente el token JWT en las variables de la colección para su uso en las siguientes peticiones."
					},
					"response": []
				},
